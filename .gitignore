# ── 환경 ────────────────────────────────
.venv/
.env
__pycache__/
*.py[cod]
*.egg-info/

# ── upstream (별도 저장소, 수정하지 않음) ──
upstream/

# ── 모델 가중치 · 캐시 (전부 프로젝트 안에 둔다, setup/_env.ps1 참고) ──
# models/  : HuggingFace 가중치 약 25GB + 인증 토큰
# cache/   : pip · wheels · triton · tmp
models/
cache/
*.safetensors
*.ckpt
*.pth

# ── 실행 산출물 ──────────────────────────
runs/
tmp/
autotune_cache.json
*.glb

# ── 웹 vendor (로컬 동봉 JS, 용량 큼) ──
web/vendor/*.js
web/vendor/*.min.js
!web/vendor/.gitkeep

# ── 입력 이미지 ──────────────────────────
# inputs/         개인 이미지를 두는 곳. 추적하지 않는다.
# inputs/samples/ upstream 공식 샘플 중 가벼운 것만 추적한다.
#                 원본 고해상도(4096px, 총 59MB)는 upstream 클론에 이미 있으므로
#                 중복 저장하지 않는다 -> upstream/Pixal3D/assets/images/
inputs/*
!inputs/.gitkeep
!inputs/README.md
!inputs/samples/
inputs/samples/*
!inputs/samples/.gitkeep

# 가벼운 것만 (각 1MB 미만). 나머지는 upstream 클론으로 얻는다.
!inputs/samples/1_img.png
!inputs/samples/9_img.png
!inputs/samples/21_img.png
!inputs/samples/s_18_img.png
!inputs/samples/4_img.png

# ── OS ──────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store

# ── 서버 로그 ────────────────────────────
logs/

# ── 배치 보고서 (머신별 실측값) ──────────
reports/
