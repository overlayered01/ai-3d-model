# Pixal3D 로컬 테스트 환경변수
# 사용법: 이 파일을 .env 로 복사한 뒤 값을 조정한다.
#         server/config.py 가 읽는다.

# ── 저장 위치 ────────────────────────────────────────────────
# 가중치·캐시·임시파일은 전부 프로젝트 폴더 안에 둔다.
#   models/hf     HuggingFace 가중치 약 25GB + 인증 토큰
#   models/torch  torch.hub 캐시
#   cache/        pip · wheels · triton · tmp
#
# 경로는 setup/_env.ps1(PowerShell)과 server/config.py(파이썬)가
# 프로젝트 위치에서 계산하므로 여기 적을 필요가 없다.
# 프로젝트를 통째로 옮겨도 그대로 동작한다.
#
# 데이터만 다른 디스크에 두고 싶으면 이 값만 지정한다.
# 지정하면 그 아래에 models/ 와 cache/ 가 같은 구조로 만들어진다.
# PIXAL3D_DATA_ROOT=E:\pixal3d-data

# ── 런타임 ──────────────────────────────────────────────────
# flash_attn 을 설치하지 않으므로 PyTorch SDPA 백엔드를 쓴다.
ATTN_BACKEND=sdpa

# ── 웹 서버 ─────────────────────────────────────────────────
# 기본값은 이 PC 에서만 접근 가능하다. (리스크 R8)
# LAN 공유가 필요하면 0.0.0.0 으로 바꾸고 Windows 방화벽 인바운드 규칙을 추가한다.
# 무인증 상태로 외부에 노출하지 않는다 — URL 을 아는 누구나 이 GPU 를 쓰게 된다.
HOST=127.0.0.1
PORT=7860

# ── 생성 기본값 ─────────────────────────────────────────────
# 24GB 중 데스크톱이 일부를 점유하고 expandable_segments 가 Windows 에서
# 동작하지 않으므로, 저VRAM + 1024 부터 시작한다. (리스크 R4)
#
# 1536 도 실측으로 통과했다 (최대 18.7GB, 여유 2.6GB, 498초).
# 다만 여유가 얇아 데스크톱 GPU 점유가 3GB 를 넘으면 위험하다.
# 측정값은 docs/BENCHMARK.md 참고.
LOW_VRAM=1
DEFAULT_RESOLUTION=1024

# ── 재현성 ──────────────────────────────────────────────────
# 같은 seed 로 돌려도 결과가 매번 조금 다르다 (정점 수 편차 약 0.7%).
# 1 로 두면 cuDNN 알고리즘 자동선택과 TF32 를 끈다.
#
# 실측 결과 이 스위치는 듣지 않았다 — 재현은 그대로 안 되고 소요만 70%
# 늘었다. 원인이 cuDNN/TF32 가 아니라는 뜻이다. 켜지 마라.
# 안 된다는 사실을 남겨두려고 스위치만 남겼다. docs/BENCHMARK.md 참고.
DETERMINISTIC=0

# ── GLB 추출 ────────────────────────────────────────────────
# 저장용 원본
FULL_TEXTURE_SIZE=4096
FULL_DECIMATION_TARGET=1000000
# 브라우저 뷰어용 경량본 (리스크 R9)
WEB_TEXTURE_SIZE=2048
WEB_DECIMATION_TARGET=200000
# EXT_texture_webp 미지원 뷰어에서 텍스처가 누락되면 0 으로 바꾼다. (리스크 R12)
EXPORT_WEBP=1
